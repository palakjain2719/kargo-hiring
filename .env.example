# Copy to .env.local and fill in. Every value here is server-only: never prefix with NEXT_PUBLIC_.

# Supabase: leave blank to use the local file store (.data/store.json) for development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini: leave blank to use the MOCK AI provider (development only, not a real assessment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Resend: sending stays disabled (dry run) until EMAIL_SENDING_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM="Arjun Mehta <arjun@yourdomain.com>"
EMAIL_REPLY_TO=
EMAIL_SENDING_ENABLED=false
# Optional: send every email to this address instead of the candidate (for live testing)
EMAIL_TEST_RECIPIENT=

# Dashboard access (HTTP basic auth). Required in production.
DASHBOARD_USER=arjun
DASHBOARD_PASSWORD=

# Optional: protects /api/process when called by a cron job
CRON_SECRET=
